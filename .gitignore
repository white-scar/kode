# ===== 数据 / 结果 / 中间产物：目录保留，内容不入库 =====
data/*
!data/.gitkeep
outputs/*
!outputs/.gitkeep
cal/*
!cal/.gitkeep

# reproduce 下的临时 / 备份 / 缓存
reproduce/**/_verify_bak*/
reproduce/**/_bak_*/
reproduce/**/_tmp_*/
reproduce/**/__pycache__/
reproduce/**/outputs/

