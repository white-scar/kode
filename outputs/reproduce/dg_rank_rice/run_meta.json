{
  "dataset": "rice",
  "environment": "control",
  "phenotype_file": "rice_indica_control_traits.csv",
  "grm_file": "rice_GRM_226x226.csv",
  "cv_file": "rice_cv_10fold.csv",
  "condition": "full",
  "drift": "affine",
  "affine_drift": true,
  "hidden": 128,
  "activation": "tanh",
  "optimizer": "adam",
  "lr": 0.001,
  "weight_decay": 0.0001,
  "grad_clip": 1.0,
  "solver": "explicit_euler_normalized_real_gaps",
  "loss": "mse_full_trajectory",
  "checkpoint_metric": "validation_mse_excluding_t1",
  "inner_folds": 5,
  "outer_foldsets": 10,
  "seed": 42,
  "ensemble": "5 inner models averaged on fold6",
  "eval_excludes_t1": true,
  "rng": "reset torch/np seed at the start of every (D_G, rank) cell",
  "note": "本脚本只输出结果, 不自动筛参; D_G*/rank* 由人工判断",
  "grid": {
    "D_G": [
      10,
      20,
      30,
      40,
      50,
      80
    ],
    "rank": [
      1,
      2,
      3,
      4
    ]
  },
  "folds": [
    3
  ],
  "epochs": 1000
}